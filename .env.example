# Archer AI Environment Variables
# Copy this file to .env and fill in your values

# Database URL (SQLite — file path is relative to project root)
DATABASE_URL="file:./db/custom.db"

# Z.ai SDK Configuration
# The z-ai-web-dev-sdk reads credentials from environment configuration.
# Make sure to set up the SDK credentials in your environment.
# See: https://www.npmjs.com/package/z-ai-web-dev-sdk

# Optional: Port (default 3000)
PORT=3000

# Optional: Node environment
NODE_ENV=development
