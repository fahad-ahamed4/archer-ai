{
  "name": "archer-ai",
  "version": "4.0.0",
  "private": true,
  "description": "🤖 Archer AI v4.0 Aurora - Mobile Jarvis AI Assistant (Web + Windows + Android)",
  "license": "MIT",
  "workspaces": [
    "client",
    "server",
    "electron",
    "android"
  ],
  "scripts": {
    "dev": "cd client && bun run dev",
    "dev:web": "cd client && bun run dev",
    "dev:electron": "cd electron && bun run dev",
    "dev:android": "cd android && bun run dev",
    "build": "bash build.sh",
    "build:web": "cd client && bun run build",
    "build:electron": "cd electron && bun run build",
    "build:android": "cd android && bun run build",
    "build:windows": "cd electron && bun run build:win",
    "build:apk": "cd android && bun run build:apk",
    "start": "cd .next/standalone && bun server.js",
    "lint": "cd client && bun run lint",
    "release": "bun run build && echo 'Releasing... see .github/workflows/build-release.yml'",
    "clean": "rm -rf client/.next client/dist .next electron/dist android/app android/dist",
    "db:push": "cd client && bun run db:push",
    "db:generate": "cd client && bun run db:generate"
  },
  "keywords": [
    "ai-assistant",
    "jarvis",
    "voice-assistant",
    "nextjs",
    "electron",
    "capacitor",
    "android",
    "windows",
    "bangla",
    "banglish"
  ],
  "author": "Archer AI Team",
  "homepage": "https://github.com/fahad-ahamed4/archer-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fahad-ahamed4/archer-ai.git"
  },
  "bugs": {
    "url": "https://github.com/fahad-ahamed4/archer-ai/issues"
  },
  "engines": {
    "node": ">=18.17"
  }
}
